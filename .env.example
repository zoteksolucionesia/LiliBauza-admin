# Variables de entorno requeridas para LiliBauza-admin
# Copia este archivo como .env.local y rellena los valores reales.

# Supabase - Consola: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima-aqui

# Referencia del proyecto (la parte entre tu-proyecto en la URL de Supabase).
# Usada por el middleware para detectar la cookie de sesión.
NEXT_PUBLIC_SUPABASE_PROJECT_REF=tu-proyecto

# Anthropic (Claude API) - Para interpretación automática de tests con IA
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api-...

# Resend - Para envío de emails de resultados al paciente
# Obtener en: https://resend.com/api-keys (gratis hasta 100 emails/día)
RESEND_API_KEY=re_...
# Dirección de envío (requiere dominio verificado en Resend, o usa onboarding@resend.dev para pruebas)
RESEND_FROM_EMAIL=resultados@tudominio.com
