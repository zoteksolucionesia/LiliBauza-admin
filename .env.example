# Variables de entorno requeridas para LiliBauza-admin
# Copia este archivo como .env.local y rellena los valores reales.

# Supabase - Consola: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://wxbbmzeoydtygqykkrdk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_LLAVE_ANONIMA_AQUI

# Referencia del proyecto (wxbbmzeoydtygqykkrdk)
NEXT_PUBLIC_SUPABASE_PROJECT_REF=wxbbmzeoydtygqykkrdk

# Anthropic (Claude API) - Para interpretación automática de tests con IA
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api-...

# Resend - Para envío de emails de resultados al paciente
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=re_...
# Dirección de envío (requiere dominio verificado en Resend)
RESEND_FROM_EMAIL=resultados@tudominio.com

# Firma Digital + QR (Fase 4.5)
# Secret usado para computar el hash SHA-256 de los documentos.
# IMPORTANTE: NO usar el valor por defecto en producción. Generar uno único.
FIRMA_SECRET=cambia-esto-por-un-string-aleatorio-largo
# URL pública donde se aloja /verificar/[id] (sin slash final)
NEXT_PUBLIC_VERIFY_BASE_URL=https://lilibauza-admin.web.app

